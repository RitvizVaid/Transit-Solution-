{
  "name": "@transit/server",
  "version": "0.1.0",
  "private": true,
  "description": "Transit API: OTP proxy, spatial search, fares and real-time telemetry",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@fastify/websocket": "^11.3.7",
    "@transit/shared-types": "workspace:*",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
}
