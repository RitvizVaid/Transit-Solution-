# Copy to .env.local to override. All optional.

# API origin when the web app is deployed separately from the API (e.g. Vercel + Railway).
# Leave empty to call the same origin (Vite proxy in dev, nginx in Docker).
VITE_API_BASE=

# Photon-compatible geocoder. Self-host or proxy for production traffic.
VITE_GEOCODER_URL=https://photon.komoot.io

# Which city this build serves (see src/city.ts). Pair with the API's GTFS_DIR.
VITE_CITY=delhi
